{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/and00pium/.config/fastfetch/kanye.png",
    "height": 10,
    "width": 22,
    "padding": {
      "top": 1,
      "bottom": 1,
      "left": 2,
      "right": 2,
    },
  },
  "display": {
    "separator": " : ",
  },
  "modules": [
    {
      "type": "title",
      "key": "  ",
      "format": "{6} {7} {8}",
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐",
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red",
    },
    {
      "type": "kernel",
      "key": "  󰌽 Kernel",
      "format": "{2}",
      "keyColor": "red",
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "yellow",
    },
    {
      "type": "terminal",
      "key": "  󰄛 Terminal",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "  󱑞 CPU",
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  󰊴 GPU",
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": "  󰘚 Memory",
      "keyColor": "magenta",
    },
    "break",
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "green",
    },
    {
      "type": "media",
      "key": "  󰝚 Playing",
      "keyColor": "cyan",
      "format": "{3} - {1}",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
    "break",
  ],
}
