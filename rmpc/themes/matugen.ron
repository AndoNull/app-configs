#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: All,
    browser_column_widths: [20, 38, 42],
    background_color: None,
    modal_backdrop: true,
    text_color: "#e0e2e8",
    header_background_color: None,
    modal_background_color: None,
    preview_label_style: (fg: "#9acbfa"),
    preview_metadata_group_style: (fg: "#d2bfe7", modifiers: "Bold"),
    song_table_album_separator: None,
    tab_bar: (
        active_style: (fg: "#233240", bg: "#b9c8da", modifiers: "Bold"),
        inactive_style: (fg: "#8c9198", bg: None),
    ),
    highlighted_item_style: (fg: "#d2bfe7", modifiers: "Bold"),
    current_item_style: (fg: "#233240", bg: "#b9c8da", modifiers: "Bold"),
    borders_style: (fg: "#b9c8da", modifiers: "Bold"),
    highlight_border_style: (fg: "#9acbfa"),
    symbols: (song: "󰝚 ", dir: "󱍙 ", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
        song_style: (fg: "#b9c8da"),
        song_highlighted_style: None,
        song_current_style: (fg: "#233240"),
        dir_style: (fg: "#b9c8da"),
        dir_highlighted_style: None,
        dir_current_style: (fg: "#233240"),
        playlist_style: (fg: "#b9c8da"),
        playlist_highlighted_style: None,
        playlist_current_style: (fg: "#233240"),
        marker_style: (fg: "#d2bfe7"),
        marker_highlighted_style: (fg: "#d2bfe7"),
        marker_current_style: (fg: "#233240", bg: "#d2bfe7"),
    ),
    progress_bar: (
        symbols: ["", "█", "", "█", ""],
        track_style: (fg: "#272a2f", bg: None),
        elapsed_style: (fg: "#9acbfa", bg: None),
        thumb_style: (fg: "#9acbfa", bg: "#272a2f"),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],
        track_style: (fg: "#b9c8da"),
        ends_style: (fg: "#b9c8da"),
        thumb_style: (fg: "#9acbfa"),
    ),
    song_table_format: [
        (
            prop: (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
                (match:  "0", replace: (kind: Group([(kind: Text("󰎡"), style: (fg: "#b9c8da"))]))),
                (match:  "1", replace: (kind: Group([(kind: Text("󰎤"), style: (fg: "#b9c8da"))]))),
                (match:  "2", replace: (kind: Group([(kind: Text("󰎧"), style: (fg: "#b9c8da"))]))),
                (match:  "3", replace: (kind: Group([(kind: Text("󰎪"), style: (fg: "#b9c8da"))]))),
                (match:  "4", replace: (kind: Group([(kind: Text("󰎭"), style: (fg: "#b9c8da"))]))),
                (match:  "5", replace: (kind: Group([(kind: Text("󰎱"), style: (fg: "#b9c8da"))]))),
                (match:  "6", replace: (kind: Group([(kind: Text("󰎳"), style: (fg: "#b9c8da"))]))),
                (match:  "7", replace: (kind: Group([(kind: Text("󰎶"), style: (fg: "#b9c8da"))]))),
                (match:  "8", replace: (kind: Group([(kind: Text("󰎹"), style: (fg: "#b9c8da"))]))),
                (match:  "9", replace: (kind: Group([(kind: Text("󰎼"), style: (fg: "#b9c8da"))]))),
                (match: "10", replace: (kind: Group([(kind: Text("󰽽"), style: (fg: "#b9c8da"))]))),
            ])), default: (kind: Text(""), style: (fg: "#8c9198"))),
            width: "3",
            label: "Rating",
            alignment: Center,
            label_prop: (kind: Group([
                (kind: Text("󰩳"), style: (fg: "#b9c8da")),
            ]))
        ),
        (
            prop: (kind: Sticker("playCount"), style: (fg: "#b9c8da"),
                 default: (kind: Text(""), style: (fg: "#8c9198"))),
            width: "3",
            alignment: Left,
            label: "Playcount",
            label_prop: (kind: Group([
                (kind: Text("󰆙"), style: (fg: "#b9c8da")),
            ]))
        ),
        (
            prop:(kind: Text("│"), style: (fg: "#b9c8da")),
            width: "1",
            alignment: Center,
            label: "",
            label_prop: (kind: Group([
                (kind: Text("│"), style: (fg: "#b9c8da")),
            ]))
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#b9c8da"),
                default: (kind: Text("Unknown Artist"), style: (fg: "#8c9198"))),
            width: "23%",
            label_prop: (kind: Group([
                (kind: Text("Artist "), style: (fg: "#e0e2e8")),
                (kind: Text(""), style: (fg: "#b9c8da"))
            ]))
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#9acbfa"),
                default: (kind: Property(Filename), style: (fg: "#e0e2e8"),
                    default: (kind: Text("Unknown Title"), style: (fg: "#e0e2e8")))),
            width: "36%",
            label_prop: (kind: Group([
                (kind: Text("Title "), style: (fg: "#e0e2e8")),
                (kind: Text(""), style: (fg: "#b9c8da"))
            ]))
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#b9c8da"),
                default: (kind: Text("Unknown Album"), style: (fg: "#8c9198"))),
            width: "33%",
            label_prop: (kind: Group([
                (kind: Text("Album "), style: (fg: "#e0e2e8")),
                (kind: Text("󰀥"), style: (fg: "#b9c8da"))
            ]))
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#9acbfa"),
                default: (kind: Text("-"))),
            width: "8%",
            alignment: Right,
            label_prop: (kind: Group([
                (kind: Text("Length "), style: (fg: "#e0e2e8")),
                (kind: Text(" "), style: (fg: "#b9c8da"))
            ]))
        ),
    ],
    layout: Split(
        direction: Vertical, panes: [
            (size: "7", borders: "NONE", pane: Component("header")),
            (size: "100%", borders: "NONE", pane: Pane(TabContent)),
            (size: "3", borders: "NONE", pane: Component("progress_bar")),
        ]),
    browser_song_format: [
        (kind: Group([
            (kind: Property(Track)),
            (kind: Text(" ")),
        ])),
        (kind: Group([
            (kind: Property(Artist)),
            (kind: Text(" - ")),
            (kind: Property(Title)),
        ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info:  (fg: "#d2bfe7", bg: None),
        warn:  (fg: "#d2bfe7", bg: None),
        error: (fg: "#ffb4ab", bg: None),
        debug: (fg: "#b9c8da", bg: None),
        trace: (fg: "#8c9198", bg: None),
    ),
    components: {
        "header_tab_bar": Split(direction: Horizontal, panes: [
            (size: "11%", borders: "NONE", pane: Component("tab_bar_left")),
            (size: "78%", borders: "NONE", pane: Pane(Tabs)),
            (size: "11%", borders: "NONE", pane: Component("tab_bar_right")),
        ]),
        "header_line_1": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_1")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_2")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_3")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_2": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_4")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_5")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_6")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_3": Split(direction: Horizontal, panes: [
            (size: "25%", pane: Component("header_element_7")),
            (size: "1", pane: Component("header_element_space")),
            (size: "50%", pane: Component("header_element_8")),
            (size: "1", pane: Component("header_element_space")),
            (size: "25%", pane: Component("header_element_9")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header": Split(
            direction: Vertical, panes: [
                (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Rounded,
                    pane: Split(direction: Horizontal, panes: [
                        (size: "100%", borders: "NONE", pane: Component("header_tab_bar")),
                    ])
                ),
                (size: "5", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                    pane: Split(direction: Vertical, panes: [
                        (size: "100%", borders: "NONE", pane: Component("header_line_1")),
                        (size: "100%", borders: "NONE", pane: Component("header_line_2")),
                        (size: "100%", borders: "NONE", pane: Component("header_line_3")),
                    ])
                ),
            ]
        ),
        "progress_bar": Split(
            direction: Vertical, panes: [
                (size: "3", borders: "ALL", border_symbols: Rounded,
                    border_title: [
                        (kind: Property(Status(Elapsed)), style: (fg: "#e0e2e8")),
                        (kind: Property(Status(StateV2(playing_label: "─󱦟─", paused_label: "  ", stopped_label: "  "))),
                            style: (fg: "#9acbfa", modifiers: "Bold")),
                        (kind: Property(Status(Duration)), style: (fg: "#e0e2e8")),
                    ],
                    border_title_position: Top,
                    border_title_alignment: Center,
                    pane: Split(direction: Vertical, panes: [
                        (size: "100%", borders: "NONE", pane: Pane(ProgressBar)),
                    ])
                ),
            ]
        ),
        "tab_bar_left": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))),
                    style: (fg: "#e0e2e8")),
                (kind: Text("  "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Song(FileExtension)), style: (fg: "#8c9198")),
                (kind: Text(" ")),
                (kind: Property(Widget(ScanStatus)), style: (fg: "#e0e2e8", modifiers: "Bold")),
                (kind: Text(" ")),
                (kind: Property(Status(InputBuffer())), style: (fg: "#8c9198")),
            ], align: Left)))
        ]),
        "tab_bar_right": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content: (kind: Property(Status(Partition)), style: (fg: "#8c9198")), replacements: [
                    (match: "default", replace: (kind: Group([(kind: Text(""))]))),
                ]))),
                (kind: Text(" ")),
                (kind: Property(Song(Channels())), style: (fg: "#8c9198"),
                    default: (kind: Text("0"), style: (fg: "#8c9198"))),
                (kind: Text(" 󱡫 "), style: (fg: "#8c9198")),
                (kind: Text(" 󱡬"), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(Volume)), style: (fg: "#e0e2e8")),
                (kind: Text("% "), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Right)))
        ]),
        "header_element_1": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(Elapsed)), style: (fg: "#e0e2e8")),
                (kind: Text(" / "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(Duration)), style: (fg: "#e0e2e8")),
                (kind: Text(" 󱦟"), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Text(" ]"), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Left)))
        ]),
        "header_element_2": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Property(Song(Title)), style: (fg: "#e0e2e8", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#e0e2e8", modifiers: "Bold"),
                        default: (kind: Text("Unknown Title"), style: (fg: "#e0e2e8", modifiers: "Bold"))))
            ], align: Center, scroll_speed: 6)))
        ]),
        "header_element_3": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(RepeatV2(on_label: "󰑖", off_label: "󰑖",
                    on_style: (fg: "#e0e2e8", modifiers: "Bold"),
                    off_style: (fg: "#8c9198", modifiers: "Bold"))))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(RandomV2(on_label: "󰒟", off_label: "󰒟",
                    on_style: (fg: "#e0e2e8", modifiers: "Bold"),
                    off_style: (fg: "#8c9198", modifiers: "Bold"))))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯󰇊",
                    on_style: (fg: "#e0e2e8", modifiers: "Bold"),
                    off_style: (fg: "#8c9198", modifiers: "Bold"))))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊",
                    on_style: (fg: "#e0e2e8", modifiers: "Bold"),
                    off_style: (fg: "#8c9198", modifiers: "Bold"))))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(Crossfade)), style: (fg: "#8c9198"),
                    default: (kind: Text("󰴽"), style: (fg: "#8c9198"))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Group([(kind: Text("N"), style: (fg: "#8c9198", modifiers: "Bold"))]))),
                    (match: "Insert", replace: (kind: Group([(kind: Text("I"), style: (fg: "#e0e2e8", modifiers: "Bold"))]))),
                ]))),
            ], align: Right)))
        ]),
        "header_element_4": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Song(Bits())), default: (kind: Text(" "), style: (fg: "#e0e2e8")), style: (fg: "#e0e2e8")),
                (kind: Text(" bit"), style: (fg: "#b9c8da")),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(Bitrate)), default: (kind: Text(" "), style: (fg: "#e0e2e8")), style: (fg: "#e0e2e8")),
                (kind: Text(" kbps"), style: (fg: "#b9c8da")),
                (kind: Text(" ]"), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Left)))
        ]),
        "header_element_5": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Artist)), style: (fg: "#9acbfa"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#9acbfa"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Artist"), style: (fg: "#9acbfa"))]))),
                    ]))),
                (kind: Text(" - "), style: (fg: "#e0e2e8")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Album)), style: (fg: "#b9c8da"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#b9c8da"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Album"), style: (fg: "#b9c8da"))]))),
                    ]))),
            ], align: Center, scroll_speed: 6)))
        ]),
        "header_element_6": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeRemaining(separator: " "))), style: (fg: "#e0e2e8")),
                (kind: Text(" / "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeTotal(separator: " "))), style: (fg: "#e0e2e8")),
                (kind: Text(" 󱎫"), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Right)))
        ]),
        "header_element_7": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Song(SampleRate())), default: (kind: Text(" "), style: (fg: "#e0e2e8")), style: (fg: "#e0e2e8")),
                (kind: Text(" Hz"), style: (fg: "#b9c8da")),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Song(Position)), style: (fg: "#e0e2e8"),
                    default: (kind: Text("0"), style: (fg: "#e0e2e8"))),
                (kind: Text(" / "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Property(Status(QueueLength())), style: (fg: "#e0e2e8")),
                (kind: Text(" 󰴍"), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Text(" ]"), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Left)))
        ]),
        "header_element_8": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("albumartist"))), style: (fg: "#8c9198"),
                        default: (kind: Text("Unknown Albumartist"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Albumartist"), style: (fg: "#8c9198"))]))),
                    ]))),
                (kind: Text(" - "), style: (fg: "#8c9198")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("composer"))), style: (fg: "#8c9198"),
                        default: (kind: Text("Unknown Composer"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Composer"), style: (fg: "#8c9198"))]))),
                    ]))),
            ], align: Center, scroll_speed: 6)))
        ]),
        "header_element_9": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("date"))), style: (fg: "#e0e2e8"),
                        default: (kind: Text("Unknown Date"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Date"), style: (fg: "#8c9198"))]))),
                    ]))),
                (kind: Text(" | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Track)), style: (fg: "#e0e2e8"),
                        default: (kind: Text("0"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#8c9198"))]))),
                    ]))),
                (kind: Text(" / "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Disc)), style: (fg: "#e0e2e8"),
                        default: (kind: Text("0"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("0"), style: (fg: "#8c9198"))]))),
                    ]))),
                (kind: Text(" 󰥠 | "), style: (fg: "#b9c8da", modifiers: "Bold")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("genre"))), style: (fg: "#e0e2e8"),
                        default: (kind: Text("Unknown Genre"), style: (fg: "#8c9198"))),
                    replacements: [
                        (match: "", replace: (kind: Group([(kind: Text("Unknown Genre"), style: (fg: "#8c9198"))]))),
                    ]))),
            ], align: Right)))
        ]),
        "header_element_right_end": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ]"), style: (fg: "#b9c8da", modifiers: "Bold")),
            ], align: Right)))
        ]),
        "header_element_space": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" ")),
            ], align: Right)))
        ]),
    },
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        bar_width: 1, bar_spacing: 1,
        bg_color: None,
        bar_color: Gradient({
            0:   "#0c4a72",
            33:  "#b9c8da",
            67:  "#9acbfa",
            100: "#cde5ff",
        })
    ),
    lyrics: (
        timestamp: false,
        alignment: Center,
    ),
    border_symbol_sets: {
        "rounded_collapsed_top": (
            parent: Rounded,
            top_left: "├",
            top_right: "┤",
        ),
    },
)

